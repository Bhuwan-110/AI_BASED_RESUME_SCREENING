# GURUKUL-CV Environment Configuration Template
# Copy this file to '.env' and configure your values:
# cp .env.example .env

# Django Security
SECRET_KEY=change-me-to-a-secure-random-key-in-production
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Optional override - defaults to local SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=gurukul_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
